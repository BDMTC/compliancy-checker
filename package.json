{
  "name": "compliancy-checker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "spike": "cargo run -p docx-core --bin docx-spike --",
    "spike:fixtures": "cargo run -p docx-core --bin docx-spike -- generate-fixtures",
    "spike:run": "cargo run -p docx-core --bin docx-spike -- run",
    "spike:iso": "cargo run -p docx-core --bin docx-spike -- iso-checklist",
    "spike:context": "cargo run -p docx-core --bin docx-spike -- context-rules",
    "test:rust": "cargo test -p docx-core && cargo test -p compliancy-core",
    "test:assist-mock": "COMPLIANCY_ASSIST_MOCK=1 cargo test -p compliancy-core"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
